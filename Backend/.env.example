# PrepShare Backend Environment Configuration Example
# Copy this file to .env and adjust credentials accordingly.

# Environment Mode: development | production
ENVIRONMENT=production

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/prepshare

# JWT Authentication
SECRET_KEY=change_this_to_a_secure_random_secret_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SMTP Email Configuration (for OTP delivery & verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password

# Allowed CORS Origins (comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]
