# PrepShare Backend — Production Environment Configuration Example
# Copy this file to .env or set in your backend hosting dashboard (e.g. Render, Railway, Fly.io, AWS)

# Database Connection (PostgreSQL with SSL enabled)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require

# JWT Authentication
SECRET_KEY=YOUR-STRONG-RANDOM-64-CHARACTER-SECRET-KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Transactional SMTP Gateway (for Registration OTP & Password Recovery)
SMTP_HOST=YOUR-SMTP-HOST
SMTP_PORT=587
SMTP_USERNAME=YOUR-SMTP-USERNAME
SMTP_PASSWORD=YOUR-SMTP-PASSWORD

# CORS Allowed Origins (Comma-separated list of exact frontend HTTPS domains)
CORS_ORIGINS=https://YOUR-FRONTEND-URL,https://YOUR-CUSTOM-DOMAIN
