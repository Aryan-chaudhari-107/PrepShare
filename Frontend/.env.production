# Production builds (Vercel / `vite build`) call the backend through the same
# origin: vercel.json routes /api/* to the backend service and strips the
# /api prefix before FastAPI sees the path. Relative URL => works on any
# domain (production, previews, custom domains) with zero configuration.
# Local dev (mode=development) is unaffected and keeps the 127.0.0.1:8000
# fallback in src/api/client.ts.
VITE_API_BASE_URL=/api
